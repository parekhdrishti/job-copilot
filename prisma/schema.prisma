generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum ApplicationStatus {
  SAVED
  APPLIED
  OA
  INTERVIEW
  OFFER
  REJECTED
  GHOSTED
}

model Application {
  id        Int               @id @default(autoincrement())
  company   String
  role      String
  jobUrl    String?
  status    ApplicationStatus @default(SAVED)
  appliedAt DateTime?
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
}