generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}
enum ApplicationStatus {
  SAVED
  APPLIED
  OA
  INTERVIEW
  OFFER
  REJECTED
  GHOSTED
}

model Application {
  id        Int               @id @default(autoincrement())
  company   String
  role      String
  jobUrl    String?
  status    ApplicationStatus @default(SAVED)
  appliedAt DateTime?
  notes     String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  matchScores MatchScore[]
}

model MatchScore {
  id             Int         @id @default(autoincrement())
  application    Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  applicationId  Int
  resume         Resume      @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  resumeId       Int
  score          Int
  summary        String
  strengths      String[]
  gaps           String[]
  suggestions    String[]
  jobDescription String
  createdAt      DateTime    @default(now())

  @@index([applicationId])
  @@index([resumeId])
}
model Resume {
  id        Int      @id @default(autoincrement())
  name      String   @default("Main resume")
  text      String
  createdAt DateTime @default(now())

  matchScores MatchScore[]
}
model GoogleAccount {
  id           Int      @id @default(autoincrement())
  email        String   @unique
  refreshToken String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}